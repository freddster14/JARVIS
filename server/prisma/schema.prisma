datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id            String         @id @default(cuid())
  name          String
  durationMin   Int
  priority      Int            @default(1)
  category      String?
  weeklyGoal    Int            @default(1)
  createdAt     DateTime       @default(now())
  scheduleItems ScheduleItem[]
  completions   Completion[]
}

model FixedBlock {
  id         String                @id @default(cuid())
  name       String
  dayOfWeek  Int
  startTime  String
  endTime    String
  recurring  Boolean               @default(true)
  /// Set only when recurring = false: the single date this one-off block applies to.
  date       DateTime?
  exceptions FixedBlockException[]
}

/// A single date where a normally-recurring FixedBlock doesn't apply
/// (e.g. "skip Work on 2026-07-24 because I'm off that day").
model FixedBlockException {
  id           String     @id @default(cuid())
  fixedBlockId String
  fixedBlock   FixedBlock @relation(fields: [fixedBlockId], references: [id], onDelete: Cascade)
  date         DateTime

  @@unique([fixedBlockId, date])
}

model ScheduleItem {
  id            String         @id @default(cuid())
  taskId        String
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date          DateTime
  startTime     String
  endTime       String
  status        String         @default("pending")
  notifiedAt    DateTime?
  focusSessions FocusSession[]
}

/// A Pomodoro-style focus session for one ScheduleItem occurrence. Server-persisted
/// (rather than a client-side timer) so phase timing and reminder nagging keep working
/// even while the app is closed or backgrounded.
model FocusSession {
  id             String       @id @default(cuid())
  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  /// Snapshot of task.durationMin at session start — the cap for this session's nagging.
  plannedMinutes Int
  /// 'work' | 'break' | 'long_break'
  phase          String       @default("work")
  phaseStartedAt DateTime     @default(now())
  phaseEndsAt    DateTime
  /// Completed work phases so far — decides 25/5 short break vs 25/15 long break.
  cycleCount     Int          @default(0)
  /// 'running' | 'paused' | 'awaiting_ack' | 'needs_resolution' | 'completed' | 'cancelled'
  status         String       @default("running")
  /// Next time a reminder push is due; null while running or once resolved/stopped.
  nextNagAt      DateTime?
  lastNotifiedAt DateTime?
  /// When the current pause began; null unless status = 'paused'.
  pausedAt       DateTime?
  /// Snapshot of ms left in the current phase, taken at pause time, restored on resume.
  remainingMsAtPause Int?
  /// Cumulative minutes spent paused — subtracted when checking the plannedMinutes cap.
  pausedMinutesTotal Int      @default(0)
  resolvedActualMinutes Int?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Completion {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  weekStart DateTime
  scheduled Int
  completed Int
  skipped   Int
}

model UserProfile {
  id               String  @id @default(cuid())
  wakeUpMode       String  @default("fixed")
  fixedWakeTime    String?
  morningPingTime  String?
  fallbackWakeTime String?
}

model DailyWakeLog {
  id       String   @id @default(cuid())
  date     DateTime @unique
  wakeTime String
  source   String
}

/// A tip generated after a weekly schedule is created, optionally paired with
/// concrete reschedule actions the user can apply with one click.
model ScheduleTip {
  id        String   @id @default(cuid())
  weekStart DateTime
  text      String
  /// TipAction[] — { scheduleItemId, date, startTime, endTime } — null if not mechanically actionable.
  actions   Json?
  status    String   @default("unread")
  createdAt DateTime @default(now())
}
