# Copy this file to .env and fill in your values

# Anthropic API key — get it from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# VAPID keys for web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your@email.com

# PostgreSQL (Neon) — pooled connection string, used at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct (unpooled) connection string, used only for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Optional
PORT=3001
CLIENT_URL=http://localhost:5173
